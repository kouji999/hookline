{
  "name": "rewatch",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "author": "Raliq Hidayat BM3",
  "description": "Rewatch — AI attention-signal console by Raliq Hidayat BM3: find the most re-watched moments in any YouTube video, then render them into viral 9:16 clips",
  "scripts": {
    "dev": "concurrently -n FE,BE -c yellow,green \"npm:dev-frontend\" \"npm:dev-backend\"",
    "dev-frontend": "vite",
    "dev-backend": "cd backend && python -m uvicorn main:app --reload --port 8000",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:backend": "python -m pytest backend/tests -q",
    "test:frontend": "vitest run",
    "test": "npm run test:frontend && npm run test:backend"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
